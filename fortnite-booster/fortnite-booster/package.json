{
  "name": "fortnite-booster",
  "version": "1.0.0",
  "description": "Otimizador de desempenho para Windows 10/11 com foco no Fortnite",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fortnitebooster.app",
    "productName": "FORTNITE BOOSTER",
    "files": ["main.js", "preload.js", "src/**/*", "renderer/**/*"],
    "extraResources": [{ "from": "tools", "to": "tools", "filter": ["**/*"] }],
    "win": { "target": ["nsis", "portable"], "requestedExecutionLevel": "asInvoker" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
